# Attack Simulation Config — sesuaikan sebelum sesi testing
# Source: source attack_config.env

DEV1="KNWKUKT8OZDMMZGY"          # adb device ID UE-1  (adb devices)
DEV2="ZE223GNJ6B"                 # adb device ID UE-2

TARGET_IP="10.45.0.1"             # IP UPF Open5GS (ogstun gateway)
IPERF_PORT="5202"

RIC_HOST="ric-testbed"             # SSH ke RIC (via ProxyJump, lihat ~/.ssh/config)
CORE_HOST="telmat@10.91.2.4"      # SSH ke Core (Open5GS)
GNB_HOST="telmat@10.91.2.1"       # SSH ke gNB — alternatif node untuk USRP jammer
JAMMER_HOST="$RIC_HOST"           # Ganti ke $GNB_HOST jika CPU RIC > 60% sebelum S5
LABEL_FILE="/tmp/xapp_label"      # path di RIC

USRP_FREQ="1.8425e9"              # DL center freq gNB — Band 3, dl_arfcn=368500 → 1842.5 MHz
                                  # UL alt: 1.7475e9 (jam pusch_snr instead of CQI)
USRP_GAIN="70"
USRP_RATE="10e6"                  # match gNB 10 MHz channel bandwidth (gnb_usrp.yaml)
JAMMER_BURST_SEC="10"             # duration per burst (ON phase)
JAMMER_BURSTS="8"                 # number of ON/OFF cycles in one session
JAMMER_SLEEP_SEC="8"              # sleep between bursts (OFF phase)

# SSH port forwarding Termux (setup via helpers/setup_termux_ssh.sh)
UE1_SSH_PORT="8023"
UE2_SSH_PORT="8022"
